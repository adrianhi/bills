# Configuración del Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Supabase Auth (public values may be duplicated for Vite and API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_APP_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Assigns legacy rows to this user on their first authenticated bootstrap
LEGACY_OWNER_EMAIL=owner@example.com

# Resend inbound (use the temporary receiving domain in development)
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
RESEND_RECEIVING_DOMAIN=your-receiving-domain.resend.app
INGESTION_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Gmail OAuth (use separate Google Cloud projects for testing and production)
GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/google/callback
GMAIL_INITIAL_SYNC_DAYS=90
GMAIL_SYNC_MAX_MESSAGES=100

# Base de Datos Local (PostgreSQL Docker / Localhost)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bills_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bills_db?schema=public"

# Base de Datos Producción (Supabase - Configurar en las variables de entorno de tu hosting / Render / Railway)
# Never place real production credentials in this example file.
