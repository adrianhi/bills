# Configuración del Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Supabase Auth (public values may be duplicated for Vite and API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_APP_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Assigns legacy rows to this user on their first authenticated bootstrap
LEGACY_OWNER_EMAIL=owner@example.com

# Resend inbound (use the temporary receiving domain in development)
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
RESEND_RECEIVING_DOMAIN=your-receiving-domain.resend.app
INGESTION_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Gmail OAuth (use separate Google Cloud projects for testing and production)
GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/google/callback
GMAIL_INITIAL_SYNC_DAYS=90
GOOGLE_PUBSUB_TOPIC=projects/replace-me/topics/bills-gmail
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://api.example.com/api/v1/webhooks/google/gmail
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=bills-gmail-push@replace-me.iam.gserviceaccount.com
GMAIL_RECONCILE_INTERVAL_MINUTES=5
GMAIL_WATCH_RENEWAL_HOURS=24
GMAIL_SYNC_CONCURRENCY=4

# Legal identity and audit evidence (required in production)
LEGAL_PROVIDER_NAME=Your legal name or registered business
LEGAL_PROVIDER_ID=RNC-or-identification-reference
LEGAL_CONTACT_EMAIL=privacidad@your-domain.com
LEGAL_CONTACT_ADDRESS=Santo Domingo, República Dominicana
LEGAL_AUDIT_SALT=replace_with_at_least_32_random_characters

# Base de Datos Local (PostgreSQL Docker / Localhost)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bills_db?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bills_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bills_db?schema=public"

# Base de Datos Producción (Supabase - Configurar en las variables de entorno de tu hosting / Render / Railway)
# Never place real production credentials in this example file.
