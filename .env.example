# Server Configuration
PORT=3000
NODE_ENV=production

# Security API Key for Ingestion (Used by n8n HTTP Request node)
API_KEY=secret_token

# Database Configuration (Supabase PostgreSQL)
# 1. DATABASE_URL: Pooler / Supavisor connection string (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# 2. DIRECT_URL: Direct PostgreSQL connection string (Session mode, port 5432, for Prisma migrations/db push)
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# CORS Configuration (* or your custom domain)
CORS_ORIGIN=*
