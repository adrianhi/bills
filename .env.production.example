# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - bills.
# Copia estas variables en el panel de tu hosting (Render, Railway, VPS, etc.)
# ==============================================================================

# Entorno y Servidor
NODE_ENV=production
PORT=3000
PROCESS_ROLE=all

# URLs Públicas (HTTPS OBLIGATORIO EN PRODUCCIÓN)
# Reemplaza 'tu-app.onrender.com' por tu subdominio de Render o dominio propio (ej. bills.do)
APP_URL=https://tu-app.onrender.com
API_PUBLIC_URL=https://tu-app.onrender.com
CORS_ORIGIN=https://tu-app.onrender.com

# ------------------------------------------------------------------------------
# Supabase Authentication & Client
# Obtenidos en Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_APP_URL=https://tu-app.onrender.com

# Opcional: correo que reclamará automáticamente transacciones legacy huérfanas
LEGACY_OWNER_EMAIL=tu-correo@example.com

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL (Supabase Connection Pooler)
# DATABASE_URL: Puerto 6543 con ?pgbouncer=true (Transaction Mode para el pooler)
# DIRECT_URL: Puerto 5432 (Session Mode necesario para Prisma Migrate)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.tu-proyecto:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.tu-proyecto:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Seguridad y Cifrado
# INGESTION_ENCRYPTION_KEY: Clave base64 de exactamente 32 bytes (AES-256-GCM)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LEGAL_AUDIT_SALT: Mínimo 32 caracteres aleatorios para sellar la auditoría legal
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ------------------------------------------------------------------------------
INGESTION_ENCRYPTION_KEY=genera_tu_clave_base64_de_32_bytes==
LEGAL_AUDIT_SALT=genera_una_cadena_de_al_menos_32_caracteres_aleatorios

# ------------------------------------------------------------------------------
# Identidad Legal Obligatoria (Leyes 172-13 y 358-05 de República Dominicana)
# Requeridas por la API en modo producción para desplegar los Términos y Privacidad
# ------------------------------------------------------------------------------
LEGAL_PROVIDER_NAME="Nombre del Titular o Razón Social"
LEGAL_PROVIDER_ID="RNC-o-Cedula-del-Responsable"
LEGAL_CONTACT_EMAIL=soporte@tu-dominio.com
LEGAL_CONTACT_ADDRESS="Santo Domingo, República Dominicana"

# ------------------------------------------------------------------------------
# Tareas de Mantenimiento y Reconciliación
# Secreto para el Cron Job en POST /api/v1/internal/maintenance/tick
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
MAINTENANCE_SECRET=un_secreto_largo_y_aleatorio_para_el_cron

# ------------------------------------------------------------------------------
# Integración Gmail OAuth (Google Cloud Console)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=tu-cliente.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-secreto-google
GOOGLE_OAUTH_REDIRECT_URI=https://tu-app.onrender.com/api/v1/oauth/google/callback
GMAIL_INITIAL_SYNC_MONTHS=2
GMAIL_RECONCILE_INTERVAL_MINUTES=5
GMAIL_WATCH_RENEWAL_HOURS=24
GMAIL_SYNC_CONCURRENCY=4
GMAIL_BACKFILL_CONCURRENCY=2

# Opcional: Solo si activas Google Cloud Pub/Sub Push en producción
# GOOGLE_PUBSUB_TOPIC=projects/tu-proyecto/topics/bills-gmail
# GOOGLE_PUBSUB_PUSH_AUDIENCE=https://tu-app.onrender.com/api/v1/webhooks/google/gmail
# GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=bills-push@tu-proyecto.iam.gserviceaccount.com

# ------------------------------------------------------------------------------
# Resend Email (Opcional - Notificaciones y Weekly Digest)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_...
