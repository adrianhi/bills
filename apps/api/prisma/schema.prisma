datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceType {
  PERSONAL
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum PlanTier {
  BETA
}

enum InstitutionStatus {
  PILOT
  ACTIVE
  COMING_SOON
  DISABLED
}

enum IngestionChannel {
  EMAIL_FORWARD
  MANUAL
  CSV_IMPORT
  GMAIL_OAUTH
}

enum InboxProvider {
  GOOGLE
  MICROSOFT
  EMAIL_FORWARD
}

enum InboxConnectionStatus {
  PENDING
  ACTIVE
  REAUTH_REQUIRED
  ERROR
  REVOKED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  GOOGLE_API_DISCLOSURE
  DATA_DELETION
}

enum LegalAcceptanceSource {
  SIGNUP
  RECONSENT
  SETTINGS
}

enum ConnectionStatus {
  PENDING
  VERIFYING
  ACTIVE
  ERROR
  DISABLED
}

enum IngestionEventStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  IGNORED
  FAILED
}

enum TransactionStatusCode {
  PENDING
  APPROVED
  DECLINED
  REVERSED
}

enum TransactionStatusResolution {
  MATCHED
  UNMATCHED
  AMBIGUOUS
}

enum BudgetScope {
  GLOBAL
  CATEGORY
}

enum BudgetLimitKind {
  RECURRING
  MONTH_OVERRIDE
}

enum IngestionJobType {
  GMAIL_INITIAL_BACKFILL
  GMAIL_BANK_BACKFILL
  GMAIL_HISTORY_SYNC
  GMAIL_RECONCILIATION
  GMAIL_WATCH_RENEWAL
  GMAIL_FAILED_REPLAY
}

enum IngestionJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Profile {
  id                           String               @id @db.Uuid
  email                        String               @unique
  displayName                  String?              @map("display_name")
  timezone                     String               @default("America/Santo_Domingo")
  defaultCurrency              String               @default("DOP") @map("default_currency")
  onboardingCompletedAt        DateTime?            @map("onboarding_completed_at")
  productGuideVersionSeen      String?              @map("product_guide_version_seen")
  productGuideCompletedVersion String?              @map("product_guide_completed_version")
  productGuideCompletedAt      DateTime?            @map("product_guide_completed_at")
  memberships                  WorkspaceMember[]
  oauthStates                  OAuthState[]
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")
  legalAcceptances             LegalAcceptance[]
  integrationConsents          IntegrationConsent[]

  @@map("profiles")
}

model Workspace {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  type             WorkspaceType            @default(PERSONAL)
  planTier         PlanTier                 @default(BETA) @map("plan_tier")
  members          WorkspaceMember[]
  transactions     Transaction[]
  categoryRules    CategoryRule[]
  ruleApplications RuleApplication[]
  bankConnections  BankConnection[]
  inboxConnections InboxConnection[]
  oauthStates      OAuthState[]
  ingestionEvents  IngestionEvent[]
  ingestionJobs    IngestionJob[]
  statusEvents     TransactionStatusEvent[]
  spendingBudgetLimits SpendingBudgetLimit[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@map("workspaces")
}

model SpendingBudgetLimit {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  currency      String
  scope         BudgetScope
  targetKey     String          @map("target_key")
  categoryKey   String?         @map("category_key")
  categoryLabel String?         @map("category_label")
  kind          BudgetLimitKind
  effectiveMonth DateTime       @map("effective_month") @db.Date
  amount        Decimal?        @db.Decimal(12, 2)
  disabled      Boolean         @default(false)
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([workspaceId, currency, targetKey, kind, effectiveMonth])
  @@index([workspaceId, currency, effectiveMonth])
  @@map("spending_budget_limits")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  profileId   String        @map("profile_id") @db.Uuid
  role        WorkspaceRole @default(OWNER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@id([workspaceId, profileId])
  @@index([profileId])
  @@map("workspace_members")
}

model FinancialInstitution {
  code               String                         @id
  displayName        String                         @map("display_name")
  status             InstitutionStatus              @default(COMING_SOON)
  senderPatterns     String[]                       @default([]) @map("sender_patterns")
  connections        BankConnection[]
  transactions       Transaction[]
  statusEvents       TransactionStatusEvent[]
  inboxSubscriptions InboxInstitutionSubscription[]
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  @@map("financial_institutions")
}

model BankConnection {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  institutionCode     String               @map("institution_code")
  inboxConnectionId   String?              @map("inbox_connection_id") @db.Uuid
  ingestionChannel    IngestionChannel     @default(EMAIL_FORWARD) @map("ingestion_channel")
  status              ConnectionStatus     @default(PENDING)
  sourceEmail         String?              @map("source_email")
  sourceEmailVerified Boolean              @default(false) @map("source_email_verified")
  lastEventAt         DateTime?            @map("last_event_at")
  lastErrorCode       String?              @map("last_error_code")
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  institution         FinancialInstitution @relation(fields: [institutionCode], references: [code], onDelete: Restrict)
  inboxConnection     InboxConnection?     @relation(fields: [inboxConnectionId], references: [id], onDelete: Cascade)
  ingestionAddress    IngestionAddress?
  ingestionEvents     IngestionEvent[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([workspaceId, institutionCode, ingestionChannel])
  @@index([workspaceId, status])
  @@index([inboxConnectionId])
  @@map("bank_connections")
}

model InboxConnection {
  id                       String                         @id @default(uuid()) @db.Uuid
  workspaceId              String                         @map("workspace_id") @db.Uuid
  provider                 InboxProvider
  providerAccountId        String                         @map("provider_account_id")
  email                    String
  status                   InboxConnectionStatus          @default(PENDING)
  encryptedAccessToken     String?                        @map("encrypted_access_token") @db.Text
  encryptedRefreshToken    String?                        @map("encrypted_refresh_token") @db.Text
  tokenExpiresAt           DateTime?                      @map("token_expires_at")
  scopes                   String[]                       @default([])
  syncCursor               String?                        @map("sync_cursor")
  lastSyncedAt             DateTime?                      @map("last_synced_at")
  lastSuccessfulSyncAt     DateTime?                      @map("last_successful_sync_at")
  nextReconcileAt          DateTime?                      @map("next_reconcile_at")
  syncLeaseUntil           DateTime?                      @map("sync_lease_until")
  watchExpiresAt           DateTime?                      @map("watch_expires_at")
  lastSyncSummary          Json?                          @map("last_sync_summary")
  lastErrorCode            String?                        @map("last_error_code")
  grantedAt                DateTime?                      @map("granted_at")
  revokedAt                DateTime?                      @map("revoked_at")
  workspace                Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankConnections          BankConnection[]
  ingestionEvents          IngestionEvent[]
  ingestionJobs            IngestionJob[]
  integrationConsents      IntegrationConsent[]
  institutionSubscriptions InboxInstitutionSubscription[]
  createdAt                DateTime                       @default(now()) @map("created_at")
  updatedAt                DateTime                       @updatedAt @map("updated_at")

  @@unique([workspaceId, provider, providerAccountId])
  @@index([workspaceId, status])
  @@map("inbox_connections")
}

model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     String
  locale      String            @default("es-DO")
  title       String
  slug        String
  contentHash String            @map("content_hash")
  isCurrent   Boolean           @default(false) @map("is_current")
  effectiveAt DateTime          @map("effective_at")
  acceptances LegalAcceptance[]
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([type, version, locale])
  @@index([type, locale, isCurrent])
  @@map("legal_documents")
}

model LegalAcceptance {
  id              String                @id @default(uuid()) @db.Uuid
  profileId       String                @map("profile_id") @db.Uuid
  legalDocumentId String                @map("legal_document_id") @db.Uuid
  source          LegalAcceptanceSource
  locale          String                @default("es-DO")
  ipHash          String?               @map("ip_hash")
  userAgentHash   String?               @map("user_agent_hash")
  profile         Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  legalDocument   LegalDocument         @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)
  acceptedAt      DateTime              @default(now()) @map("accepted_at")

  @@unique([profileId, legalDocumentId])
  @@index([profileId, acceptedAt])
  @@map("legal_acceptances")
}

model IntegrationConsent {
  id                String          @id @default(uuid()) @db.Uuid
  profileId         String          @map("profile_id") @db.Uuid
  inboxConnectionId String          @map("inbox_connection_id") @db.Uuid
  provider          InboxProvider
  scopes            String[]        @default([])
  disclosureVersion String          @map("disclosure_version")
  grantedAt         DateTime        @default(now()) @map("granted_at")
  revokedAt         DateTime?       @map("revoked_at")
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  inboxConnection   InboxConnection @relation(fields: [inboxConnectionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([profileId, grantedAt])
  @@index([inboxConnectionId, grantedAt])
  @@map("integration_consents")
}

model AccountDeletionAudit {
  id          String   @id @default(uuid()) @db.Uuid
  subjectHash String   @map("subject_hash")
  completedAt DateTime @default(now()) @map("completed_at")

  @@index([completedAt])
  @@map("account_deletion_audits")
}

model OAuthState {
  id               String        @id
  workspaceId      String        @map("workspace_id") @db.Uuid
  profileId        String        @map("profile_id") @db.Uuid
  provider         InboxProvider
  returnTo         String        @default("/onboarding") @map("return_to")
  institutionCodes String[]      @default([]) @map("institution_codes")
  expiresAt        DateTime      @map("expires_at")
  usedAt           DateTime?     @map("used_at")
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile          Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

model InboxInstitutionSubscription {
  id                String               @id @default(uuid()) @db.Uuid
  inboxConnectionId String               @map("inbox_connection_id") @db.Uuid
  institutionCode   String               @map("institution_code")
  enabled           Boolean              @default(true)
  inboxConnection   InboxConnection      @relation(fields: [inboxConnectionId], references: [id], onDelete: Cascade)
  institution       FinancialInstitution @relation(fields: [institutionCode], references: [code], onDelete: Restrict)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([inboxConnectionId, institutionCode])
  @@index([institutionCode, enabled])
  @@map("inbox_institution_subscriptions")
}

model IngestionAddress {
  id               String         @id @default(uuid()) @db.Uuid
  bankConnectionId String         @unique @map("bank_connection_id") @db.Uuid
  aliasToken       String         @unique @map("alias_token")
  domain           String
  isActive         Boolean        @default(true) @map("is_active")
  bankConnection   BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")
  rotatedAt        DateTime?      @map("rotated_at")

  @@map("ingestion_addresses")
}

model IngestionEvent {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  bankConnectionId    String?              @map("bank_connection_id") @db.Uuid
  inboxConnectionId   String?              @map("inbox_connection_id") @db.Uuid
  provider            String               @default("RESEND")
  providerEventId     String               @unique @map("provider_event_id")
  providerEmailId     String?              @map("provider_email_id")
  status              IngestionEventStatus @default(PENDING)
  attempts            Int                  @default(0)
  parserCode          String?              @map("parser_code")
  parserVersion       String?              @map("parser_version")
  errorCode           String?              @map("error_code")
  errorMessage        String?              @map("error_message")
  rawContent          String?              @map("raw_content") @db.Text
  rawContentExpiresAt DateTime?            @map("raw_content_expires_at")
  nextAttemptAt       DateTime?            @map("next_attempt_at")
  leaseUntil          DateTime?            @map("lease_until")
  processedAt         DateTime?            @map("processed_at")
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankConnection      BankConnection?      @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  inboxConnection     InboxConnection?     @relation(fields: [inboxConnectionId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt, leaseUntil])
  @@index([workspaceId, createdAt])
  @@index([inboxConnectionId, createdAt])
  @@map("ingestion_events")
}

model IngestionJob {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  inboxConnectionId String             @map("inbox_connection_id") @db.Uuid
  type              IngestionJobType
  status            IngestionJobStatus @default(PENDING)
  dedupeKey         String             @unique @map("dedupe_key")
  payload           Json?
  attempts          Int                @default(0)
  maxAttempts       Int                @default(5) @map("max_attempts")
  nextAttemptAt     DateTime           @default(now()) @map("next_attempt_at")
  leaseUntil        DateTime?          @map("lease_until")
  errorCode         String?            @map("error_code")
  errorMessage      String?            @map("error_message")
  startedAt         DateTime?          @map("started_at")
  processedAt       DateTime?          @map("processed_at")
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxConnection   InboxConnection    @relation(fields: [inboxConnectionId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([inboxConnectionId, createdAt])
  @@map("ingestion_jobs")
}

model BetaInvite {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("beta_invites")
}

model Transaction {
  id               String                   @id @default(uuid())
  workspaceId      String?                  @map("workspace_id") @db.Uuid
  institutionCode  String                   @default("BHD") @map("institution_code")
  ingestionChannel IngestionChannel         @default(EMAIL_FORWARD) @map("ingestion_channel")
  externalId       String                   @map("external_id")
  cardLast4        String?                  @map("card_last_4")
  cardType         String?                  @map("card_type")
  rawMerchant      String                   @map("raw_merchant")
  merchantKey      String?                  @map("merchant_key")
  merchantIdentityLabel String?             @map("merchant_identity_label")
  categoryOrigin   String                   @default("LEGACY_UNKNOWN") @map("category_origin")
  merchantOrigin   String                   @default("LEGACY_UNKNOWN") @map("merchant_origin")
  categoryRuleId   String?                  @map("category_rule_id")
  merchantRuleId   String?                  @map("merchant_rule_id")
  classificationVersion Int                @default(0) @map("classification_version")
  merchant         String
  category         String
  amount           Decimal                  @db.Decimal(18, 2)
  currency         String                   @default("DOP")
  status           String                   @default("Aprobada")
  statusCode       TransactionStatusCode    @default(APPROVED) @map("status_code")
  statusUpdatedAt  DateTime?                @map("status_updated_at")
  transactionType  String                   @default("Compra") @map("transaction_type")
  transactionDate  DateTime                 @map("transaction_date")
  source           String                   @default("BHD_EMAIL")
  notes            String?
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  workspace        Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  institution      FinancialInstitution     @relation(fields: [institutionCode], references: [code], onDelete: Restrict)
  statusEvents     TransactionStatusEvent[]

  @@unique([workspaceId, institutionCode, externalId])
  @@index([workspaceId, transactionDate])
  @@index([workspaceId, institutionCode])
  @@index([transactionDate])
  @@index([category])
  @@index([currency])
  @@index([merchant])
  @@map("transactions")
}

model TransactionStatusEvent {
  id               String                      @id @default(uuid()) @db.Uuid
  workspaceId      String                      @map("workspace_id") @db.Uuid
  transactionId    String?                     @map("transaction_id")
  institutionCode  String                      @map("institution_code")
  externalId       String                      @map("external_id")
  statusCode       TransactionStatusCode       @map("status_code")
  resolution       TransactionStatusResolution @default(UNMATCHED)
  eventDate        DateTime                    @map("event_date")
  amount           Decimal                     @db.Decimal(18, 2)
  currency         String                      @default("DOP")
  cardLast4        String?                     @map("card_last_4")
  rawMerchant      String?                     @map("raw_merchant")
  bankReference    String?                     @map("bank_reference")
  source           String
  ingestionChannel IngestionChannel            @map("ingestion_channel")
  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction      Transaction?                @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  institution      FinancialInstitution        @relation(fields: [institutionCode], references: [code], onDelete: Restrict)
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  @@unique([workspaceId, institutionCode, externalId])
  @@index([workspaceId, institutionCode, eventDate])
  @@index([transactionId, eventDate])
  @@index([resolution, statusCode])
  @@map("transaction_status_events")
}

model CategoryRule {
  id                 String     @id @default(uuid())
  workspaceId        String?    @map("workspace_id") @db.Uuid
  pattern            String
  normalizedMerchant String?    @map("normalized_merchant")
  matchType          String     @default("CONTAINS") @map("match_type")
  targetKey          String     @map("target_key")
  version            Int        @default(1)
  category           String
  priority           Int        @default(0)
  isActive           Boolean    @default(true) @map("is_active")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, matchType, targetKey])
  @@index([workspaceId, priority])
  @@map("category_rules")
}

model RuleApplication {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  ruleId String @map("rule_id")
  phase String @default("PREVIEW")
  status String @default("QUEUED")
  includeUnknown Boolean @default(false) @map("include_unknown")
  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  cutoff DateTime @default(now())
  rulesSnapshot Json @map("rules_snapshot")
  fingerprint String
  cursor String?
  scanned Int @default(0)
  matched Int @default(0)
  changes Int @default(0)
  categoryChanges Int @default(0) @map("category_changes")
  merchantChanges Int @default(0) @map("merchant_changes")
  protectedManual Int @default(0) @map("protected_manual")
  protectedUnknown Int @default(0) @map("protected_unknown")
  otherRule Int @default(0) @map("other_rule")
  applied Int @default(0)
  skipped Int @default(0)
  attempts Int @default(0)
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items RuleApplicationItem[]
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@map("rule_applications")
}

model RuleApplicationItem {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  transactionId String @map("transaction_id")
  version Int
  before Json
  after Json
  reason String
  status String @default("PENDING")
  appliedAt DateTime? @map("applied_at")
  application RuleApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, transactionId])
  @@index([applicationId, status, id])
  @@map("rule_application_items")
}
